# PostgreSQL – Neon Pooled Connection (über PgBouncer, NICHT Direct)
# Neon Dashboard → Connection Details → Pooled connection (URL endet auf -pooler.region.aws.neon.tech)
# Pflicht: NullPool in session.py braucht den gepoolten Endpoint, damit Neon zwischen
# Anfragen auf 0 skalieren kann. Direct connection würde das Free-Compute-Limit erschöpfen.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Anthropic API Key (erforderlich für KI-Features: /ai/meal-plan-suggestion, /ai/chat)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# PowerSync JWT-Signing – RSA Schlüsselpaar (\\n als Zeilenumbruch-Ersatz)
# Schlüssel generieren:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# PowerSync Dashboard → Instanz → Auth → JWKS URI: https://<app>.fly.dev/auth/jwks.json
POWERSYNC_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----
POWERSYNC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMII...\n-----END PUBLIC KEY-----
# PowerSync Instanz-URL (für aud-Claim im JWT)
# PowerSync Dashboard → Instanz → Instance URL
POWERSYNC_URL=https://<instanz>.powersync.journeyapps.com
