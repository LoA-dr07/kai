# PostgreSQL – Neon Direct Connection (nicht Pooled)
# Neon Dashboard → Connection Details → Direct connection
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Anthropic API Key (erforderlich für KI-Features: /ai/meal-plan-suggestion, /ai/chat)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# PowerSync JWT-Signing – RSA Schlüsselpaar (\\n als Zeilenumbruch-Ersatz)
# Schlüssel generieren:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# PowerSync Dashboard → Instanz → Auth → JWKS URI: https://<app>.fly.dev/auth/jwks.json
POWERSYNC_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----
POWERSYNC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMII...\n-----END PUBLIC KEY-----
