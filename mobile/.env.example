# Backend API URL
# Fly.io (Produktion): https://<deine-app>.fly.dev
# Physisches Gerät (Expo Go, lokal): LAN-IP des PCs ermitteln mit `ipconfig`
# Android Emulator: http://10.0.2.2:8000
# iOS Simulator: http://localhost:8000
EXPO_PUBLIC_API_URL=https://<deine-app>.fly.dev

# PowerSync Cloud instance URL (Dashboard → Instanz-Übersicht)
EXPO_PUBLIC_POWERSYNC_URL=https://<deine-instanz>.powersync.journeyapps.com

# Muss exakt mit dem fly.io-Secret POWERSYNC_ADMIN_SECRET übereinstimmen
# (siehe backends/powersync/README.md) – schützt den PowerSync Stop/Start-Button
EXPO_PUBLIC_POWERSYNC_ADMIN_SECRET=
